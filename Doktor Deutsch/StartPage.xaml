<UserControl x:Class="Doktor_Deutsch.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Doktor_Deutsch"
             mc:Ignorable="d" 
             d:DesignHeight="425" d:DesignWidth="800">
    <Grid Style="{StaticResource DefaultGrid}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="30" VerticalAlignment="Top">
            <GroupBox Header="Menu" MinHeight="300" VerticalAlignment="Top">
                <StackPanel HorizontalAlignment="Center" Margin="5">
                    <Button Height="30" Width="120" Content="Nowa lekcja" Click="NewLesson_Click"></Button>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
