<UserControl x:Class="Doktor_Deutsch.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Doktor_Deutsch"
             mc:Ignorable="d" 
             d:DesignHeight="425" d:DesignWidth="800">
    <Grid Style="{StaticResource DefaultGrid}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="30" VerticalAlignment="Top">
            <GroupBox Style="{StaticResource GroupBoxStyle}" Header="Doktor Deutsch" MinHeight="300" VerticalAlignment="Top">
                <StackPanel HorizontalAlignment="Center" Margin="5">
                    <Button Style="{StaticResource ControlButton}" x:Name="NewLesson" Content="Ucz się" Click="NewLesson_Click"></Button>
                    <Button Style="{StaticResource ControlButton}" x:Name="Retake" Content="Powtórki" Click="Retake_Click"></Button>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
